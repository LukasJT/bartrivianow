---
import Base from '../../layouts/Base.astro';
import type {Locale} from '../../data/regions';
export const getStaticPaths=()=>['en','fr'].map(lang=>({params:{lang}}));
const lang=Astro.params.lang as Locale,fr=lang==='fr';
---
<Base {lang} alternate={'/'+(fr?'en':'fr')+'/submit/'} title={(fr?'Proposer une modification':'Suggest a listing or correction')+' | Bar Trivia Now'}>
<article class="detail frame" data-locale={lang}>
<h1>{fr?'Aidez-nous à mettre le programme à jour.':'Help keep the lineup current.'}</h1>
<p>{fr?'Indiquez un lieu, ce qui change et un lien public qui confirme les détails.':'Tell us the venue, what’s changing, and a public link that supports the details.'}</p>
<p class="muted">{fr?'Évitez d’inclure des renseignements personnels.':'Please leave personal information out of your report.'}</p>
<form class="submission" id="submission">
<label>{fr?'Lieu':'Venue'}<input name="venue" required maxlength="140"/></label>
<label>{fr?'Lien public':'Public source link'}<input name="url" type="url" required maxlength="500"/></label>
<label>{fr?'Événement ou modification':'Event or correction'}<textarea name="details" required minlength="12" maxlength="1200"></textarea></label>
<button class="primary" type="submit">{fr?'Envoyer pour révision':'Send for review'}</button>
<p id="form-status" role="status"></p>
</form>
<noscript><p>{fr?'JavaScript est nécessaire pour envoyer ce formulaire.':'JavaScript is required to send this form.'}</p></noscript>
</article>
<script>
const form=document.querySelector<HTMLFormElement>('#submission')!;
const status=document.querySelector<HTMLElement>('#form-status')!;
const button=form.querySelector<HTMLButtonElement>('button')!;
const fr=document.documentElement.lang==='fr';
const q=new URLSearchParams(location.search);
form.addEventListener('submit',async e=>{
  e.preventDefault();button.disabled=true;
  status.textContent=fr?'Envoi en cours…':'Sending…';
  try{
    const res=await fetch('/api/v1/reports',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({...Object.fromEntries(new FormData(form)),venueId:q.get('venue'),seriesId:q.get('series')})});
    if(!res.ok)throw Error();
    form.reset();status.textContent=fr?'Reçu pour révision. Merci!':'Received for review. Thank you!';
  }catch{status.textContent=fr?'Envoi indisponible. Votre texte est conservé dans le formulaire.':'Submission is unavailable. Your text is still in the form.';}
  finally{button.disabled=false;}
});
</script></Base>
