---
import '@fontsource-variable/source-sans-3';
import '@fontsource/instrument-serif/400.css';
import '../styles/main.css';
const {lang='en', title='Bar Trivia Now', description, alternate, noindex=false} = Astro.props;
const fr=lang==='fr';
const canonical=new URL(Astro.url.pathname,Astro.site);
---
<!doctype html>
<html lang={lang}>
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title><meta name="description" content={description ?? (fr?'Trouvez un quiz près de chez vous.':'Find your next local trivia night.')}>
<link rel="canonical" href={canonical}><link rel="icon" href="/icon.svg" type="image/svg+xml">
{alternate && <link rel="alternate" hreflang={fr?'en':'fr'} href={new URL(alternate,Astro.site)}/>}
{noindex && <meta name="robots" content="noindex"/>}
</head>
<body>
<a class="skip" href="#main">{fr?'Aller au contenu':'Skip to content'}</a>
<header class="mast"><div class="frame mast-inner">
<a class="brand" href={'/'+lang+'/'}><img src="/icon.svg" alt="" width="33" height="33"/>Bar Trivia Now</a>
<nav aria-label={fr?'Navigation principale':'Main navigation'}>
<a href={'/'+lang+'/#agenda'}>{fr?'Explorer':'Explore'}</a>
<a href={'/'+lang+'/coverage/'}>{fr?'Couverture':'Coverage'}</a>
<a class="lang" href={alternate ?? (fr?'/en/':'/fr/')} lang={fr?'en':'fr'}>{fr?'EN':'FR'}</a>
</nav>
</div></header>
<main id="main" tabindex="-1"><slot/></main>
<footer class="frame footer"><span>Bar Trivia Now</span><a href={'/'+lang+'/coverage/'}>{fr?'Sources et couverture':'Sources & coverage'}</a>
<a href={'/'+lang+'/submit/'}>{fr?'Proposer un événement':'Suggest an event'}</a>
<a href={'/'+lang+'/privacy/'}>{fr?'Confidentialité':'Privacy'}</a></footer>
</body></html>
